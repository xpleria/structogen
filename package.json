{
  "name": "structogen",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "author": "Xpleria",
  "scripts": {
    "build": "pnpm -r build",
    "build:renderer": "pnpm --filter @xpleria/structogen-frontend build && node scripts/copy-renderer.js",
    "clean": "pnpm -r clean",
    "copy:icons": "node scripts/copy-icons.js",
    "copy:renderer": "node scripts/copy-renderer.js",
    "dev:frontend": "pnpm --filter @xpleria/structogen-frontend dev",
    "dev:desktop": "pnpm --filter @xpleria/structogen-desktop dev",
    "dist": "pnpm dist:cli && pnpm dist:desktop",
    "dist:cli": "pnpm --filter @xpleria/structogen-cli dist",
    "dist:desktop": "pnpm --filter @xpleria/structogen-desktop dist",
    "lint": "pnpm -r lint",
    "prepare": "pnpm copy:renderer && pnpm copy:icons",
    "release": "pnpm build && pnpm prepare && pnpm dist",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "fs-extra": "^11.3.2",
    "rcedit": "^5.0.0",
    "typescript": "^5.9.2"
  }
}