{
  "name": "structogen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "author": "Xpleria",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "copy:icons": "node scripts/copy-icons.js",
    "icons:cli:win": "node scripts/set-cli-icons.js",
    "copy:desktop-renderer": "node scripts/copy-renderer.js",
    "dev:frontend": "pnpm --filter @xpleria/structogen-frontend start",
    "dev:desktop": "pnpm --filter @xpleria/structogen-desktop start",
    "package:desktop": "pnpm copy:icons && pnpm --filter @xpleria/structogen-desktop package",
    "make:desktop": "pnpm copy:icons && pnpm --filter @xpleria/structogen-desktop make",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "fs-extra": "^11.3.2",
    "rcedit": "^5.0.0",
    "typescript": "^5.9.2"
  }
}
