{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node", "electron"],
    "paths": {
      "*": ["node_modules/*"]
    }
  },
  "include": [
    "electron/**/*",
    "src/**/*",
    "forge.config.ts",
    "webpack.*.ts"
  ]
}
