{
  "name": "@xpleria/structogen-desktop",
  "productName": "Structogen Desktop",
  "version": "1.0.0",
  "description": "Structogen desktop shell.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build": "pnpm --dir ../.. copy:icons && electron-forge package",
    "package": "pnpm --dir ../.. copy:icons && electron-forge package",
    "make": "pnpm --dir ../.. copy:icons && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .webpack out"
  },
  "keywords": [],
  "author": {
    "name": "Neil Patrao",
    "email": "illusion.webs@ymail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "41.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "webpack": "^5.103.0"
  },
  "dependencies": {
    "@xpleria/structogen-core": "workspace:*",
    "@xpleria/structogen-utils": "workspace:*",
    "electron-squirrel-startup": "^1.0.1"
  }
}
